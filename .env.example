# Copy this file to .env.local for local development (never commit .env.local).
# On Vercel, add the same variable under Project Settings -> Environment Variables.

# --- Use this one on Vercel (and anywhere serverless) -------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler".
# Copy the exact host from there: the region part (aws-0-xx-xxxx-x) is specific to your project.
DATABASE_URL=postgresql://postgres.gbvbrlqvewttqmzltucr:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- Direct connection (fine for running locally, but NOT for Vercel) ---------------------------------------
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.gbvbrlqvewttqmzltucr.supabase.co:5432/postgres

# --- Optional -----------------------------------------------------------------------------------------------
# How long (ms) a line in the Google Doc must stay unchanged before it is imported. Default 45000.
# GDOC_SETTLE_MS=45000
